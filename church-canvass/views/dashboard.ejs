<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard - Canvass</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/nav', { active: 'dashboard', currentUser }) %>
  <div class="page">
    <h1>Outreach dashboard</h1>

    <div class="stat-grid">
      <div class="stat-card"><div class="num"><%= total %></div><div class="label">Total prospects</div></div>
      <div class="stat-card"><div class="num"><%= thisWeek %></div><div class="label">Added this week</div></div>
      <div class="stat-card"><div class="num"><%= decisions %></div><div class="label">Decisions made</div></div>
      <div class="stat-card"><div class="num"><%= leaderboard.length %></div><div class="label">Active soul winners</div></div>
    </div>

    <div class="dash-grid">
      <div class="card-panel">
        <h3>Prospects by stage</h3>
        <% const maxCount = Math.max(1, ...byList.map(l => l.count)); %>
        <% byList.forEach(function(l) { %>
          <div class="bar-row">
            <div class="bar-label"><%= l.name %></div>
            <div class="bar-track"><div class="bar-fill" style="width: <%= (l.count / maxCount) * 100 %>%"></div></div>
            <div class="bar-count"><%= l.count %></div>
          </div>
        <% }); %>

        <h3 style="margin-top:22px;">By interest level</h3>
        <% byInterest.forEach(function(i) { %>
          <div class="bar-row">
            <div class="bar-label" style="text-transform:capitalize;"><%= i.interest_level %></div>
            <div class="bar-track"><div class="bar-fill" style="width: <%= (i.count / maxCount) * 100 %>%"></div></div>
            <div class="bar-count"><%= i.count %></div>
          </div>
        <% }); %>

        <div class="export-row">
          <a class="btn secondary" href="/export/pdf">Download PDF report</a>
          <a class="btn ghost" href="/export/csv">Download CSV</a>
        </div>
      </div>

      <div class="card-panel">
        <h3>Leaderboard</h3>
        <% if (leaderboard.length === 0) { %>
          <p style="color:var(--text-muted); font-size:13px;">No prospects logged yet — add one from the Map view to get started.</p>
        <% } %>
        <% leaderboard.forEach(function(l, i) { %>
          <div class="leader-row">
            <span><%= i + 1 %>. <%= l.name %></span>
            <strong><%= l.count %></strong>
          </div>
        <% }); %>
        <a href="/map" class="btn" style="margin-top:16px; width:100%; text-align:center;">+ Add a prospect on the map</a>
      </div>
    </div>
  </div>
</body>
</html>
