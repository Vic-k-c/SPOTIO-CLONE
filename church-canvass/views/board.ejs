<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Board - Canvass</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/nav', { active: 'board', currentUser }) %>

  <div class="board-wrap">
    <% board.forEach(function(list) { %>
      <div class="board-list" data-list-id="<%= list.id %>">
        <div class="board-list-header">
          <span><%= list.name %></span>
          <span class="count"><%= list.cards.length %></span>
        </div>
        <div class="board-list-cards" data-list-id="<%= list.id %>">
          <% list.cards.forEach(function(card) { %>
            <div class="prospect-card interest-<%= card.interest_level %>"
                 draggable="true"
                 data-card-id="<%= card.id %>"
                 onclick="openCard(<%= card.id %>)">
              <div class="pname"><%= card.name %></div>
              <% if (card.address) { %><div class="pmeta"><%= card.address %></div><% } %>
              <% if (card.phone) { %><div class="pmeta"><%= card.phone %></div><% } %>
              <div class="ptags">
                <span class="tag"><%= card.interest_level %></span>
                <% if (card.assigned_name) { %><span class="tag"><%= card.assigned_name %></span><% } %>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    <% }); %>
  </div>

  <div class="modal-backdrop" id="modalBackdrop">
    <div class="modal-box">
      <h3>Edit prospect</h3>
      <form id="cardForm">
        <input type="hidden" id="cardId">
        <label>Name</label>
        <input type="text" id="cardName">
        <label>Phone</label>
        <input type="text" id="cardPhone">
        <label>Email</label>
        <input type="text" id="cardEmail">
        <label>Address</label>
        <input type="text" id="cardAddress">
        <label>Interest level</label>
        <select id="cardInterest">
          <option value="hot">Hot</option>
          <option value="warm">Warm</option>
          <option value="cold">Cold</option>
        </select>
        <label>Assigned to</label>
        <select id="cardAssigned">
          <option value="">Unassigned</option>
          <% users.forEach(function(u) { %>
            <option value="<%= u.id %>"><%= u.name %></option>
          <% }); %>
        </select>
        <label>Notes</label>
        <textarea id="cardNotes"></textarea>
        <div class="modal-actions">
          <% if (currentUser.role === 'admin' || currentUser.role === 'leader') { %>
            <button type="button" class="btn danger" onclick="deleteCard()">Delete</button>
          <% } else { %><span></span><% } %>
          <div>
            <button type="button" class="btn ghost" onclick="closeModal()">Cancel</button>
            <button type="submit" class="btn">Save</button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
  <script>window.BOARD_DATA = <%- JSON.stringify(board) %>;</script>
  <script src="/js/board.js"></script>
</body>
</html>
